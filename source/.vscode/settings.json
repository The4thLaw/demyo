{
	"sonarlint.connectedMode.project": {
		"connectionId": "the4thlaw",
		"projectKey": "The4thLaw_demyo"
	},

	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"tsconfig.json": "tsconfig.*.json, env.d.ts, typed-router.d.ts",
		"package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .oxlint*, oxlint*, .oxfmt*, .prettier*, prettier*, .editorconfig, .nvmrc",
		".env": ".env.*"
	},

	"java.test.config": {
		"name": "javaUnitTestConfiguration",
		"vmArgs": [
			"-Djava.awt.headless=true",
			"-Ddemyo.userDirectory=target/user-directory"
		]
	},
	"java.test.defaultConfig": "javaUnitTestConfiguration"
}
